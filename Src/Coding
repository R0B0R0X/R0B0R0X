void moveRight() {
  // Steering to the right side of red blocks
  steeringServo.write(120);  // Turn right
  analogWrite(ENA, 255);  // Move forward
}

void moveLeft() {
  // Steering to the left side of green blocks
  steeringServo.write(60);  // Turn left
  analogWrite(ENA, 255);  // Move forward
}
