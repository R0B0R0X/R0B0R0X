void loop() {
  // Get distance readings from ultrasonic sensors
  distance1 = getDistance(TRIG_PIN_1, ECHO_PIN_1);
  distance2 = getDistance(TRIG_PIN_2, ECHO_PIN_2);
  
  // Process ESP32 camera image (detect red or green obstacles)
  int detectedColor = detectColor();  // Function to detect red or green using the ESP32

  // Control logic based on color and distance
  if (detectedColor == 1) { // Red detected
    // Go to the right
    moveRight();
  } else if (detectedColor == 2) { // Green detected
    // Go to the left
    moveLeft();
  }

  // Additional obstacle detection using ultrasonic sensors
  if (distance1 < 30 || distance2 < 30) {
    // Obstacle detected, stop and decide based on detected color
    analogWrite(ENA, 0);  // Stop the motors
  }
}

int getDistance(int trigPin, int echoPin) {
  long duration, distance;
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  duration = pulseIn(echoPin, HIGH);
  distance = duration * 0.034 / 2;
  return distance;
}

